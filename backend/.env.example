# Copy to `backend/.env` (never commit `.env`).
# Generate JWT_SECRET_KEY:  python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=development

# Local default (SQLite file in backend/).
DATABASE_URL=sqlite:///./sulyap.db

# Supabase (Postgres): paste the URI from Project Settings → Database → Connect.
# Session mode (port 5432) is preferred for the long-lived FastAPI process.
# The app upgrades postgresql:// → postgresql+psycopg://, adds sslmode=require, and
# percent-encodes password characters like @ [ ] so they do not break the URI.
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

JWT_SECRET_KEY=replace-with-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=15
REFRESH_TOKEN_EXP_DAYS=7

# Must include your real Vercel app URL (no trailing slash). Add localhost for local dev.
FRONTEND_ORIGINS=http://localhost:3000,https://sulyap-lasalyano-gecapistranos-projects.vercel.app

# Cross-site frontend (e.g. Vercel) + API (e.g. Render): SameSite=None + Secure is required or auth cookies are not sent.
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# Local HTTP only: use lax + insecure cookies (do not use none without Secure — browsers will reject it).
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_SEARCH=30/minute

# Optional per-artifact AI assist (Curator Desk toggle)
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_API_BASE=https://api.openai.com/v1

