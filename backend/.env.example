# Copy to `backend/.env` (never commit `.env`).
# Generate JWT_SECRET_KEY:  python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=development

# Local curator seed password (default admin123 when unset and APP_ENV≠production).
# Login accepts username `admin` or email `curator@example.com`.
# ADMIN_SEED_PASSWORD=admin123

# Local default (SQLite file in backend/).
DATABASE_URL=sqlite:///./sulyap.db

# Catalog sync remote (typically the same Supabase URI as production). Never commit the real URI.
# Used by `python scripts/sync_catalog.py` and optional POST /admin/catalog/sync.
# When DATABASE_URL is already Supabase Postgres, set this to sqlite:///./sulyap.db (or keep a
# local sulyap.db file) so CLI sync still has two endpoints. Users/password hashes are never copied.
# SYNC_REMOTE_DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Bidirectional catalog mirror on API startup (local sqlite <-> Supabase). Never syncs users.
# Default is on. Set 0 to skip. When DATABASE_URL is already Supabase, a local sulyap.db is created/used.
# CATALOG_SYNC_ON_START=1

# Supabase (Postgres): paste the URI from Project Settings → Database → Connect.
# Session mode (port 5432) is preferred for the long-lived FastAPI process.
# The app upgrades postgresql:// → postgresql+psycopg://, adds sslmode=require, and
# percent-encodes password characters like @ [ ] so they do not break the URI.
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

JWT_SECRET_KEY=replace-with-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=15
REFRESH_TOKEN_EXP_DAYS=7

# Must include your real Vercel app URL (no trailing slash). Add localhost for local dev.
# Include the static site origin if Live Scan/catalog calls the API from hall/serve.mjs.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:8765,https://sulyap-lasalyano-gecapistranos-projects.vercel.app

# Cross-site frontend (e.g. Vercel) + API (e.g. Render): SameSite=None + Secure is required or auth cookies are not sent.
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# Local HTTP only: use lax + insecure cookies (do not use none without Secure — browsers will reject it).
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_SEARCH=30/minute

# Optional per-artifact AI assist (Curator Desk toggle)
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_API_BASE=https://api.openai.com/v1

# Supabase Storage (catalog photos AND 3D GLB models). Service role is server-side / local scripts only — never put it in the frontend.
# Dashboard → Project Settings → API: Project URL + service_role secret (a long JWT, not the anon key).
# Use https://<project-ref>.supabase.co  — NOT the dashboard URL (https://supabase.com/dashboard/project/...).
# Dashboard → Storage: create a public bucket named catalog-photos (or let upload_catalog_photos.py create it).
# Binaries stay in Storage; Postgres only stores public https URLs on image_url / photo_url / model_url (never BYTEA).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=catalog-photos
# Serve compressed GLBs from a host that is not billed as Supabase Cached Egress (R2, Pages).
# Production always hides Storage GLB URLs; set this after the models host is live.
# PUBLIC_MODEL_BASE_URL=https://your-models-host.example
# CATALOG_OMIT_STORAGE_MODELS=true
# Local/dev (APP_ENV≠production): catalog returns /media/models and /catalog/.../photo
# when files exist under backend/uploads/. Production always uses stored cloud URLs.
# CATALOG_PREFER_LOCAL_MEDIA=true

