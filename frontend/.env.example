# Copy to .env.local (never commit secrets).
NEXT_PUBLIC_APP_NAME=Sulyap Lasalyano
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Local FastAPI prefers files in backend/uploads/ (photos + GLBs) so Storage is not billed.
# Production Vercel must point at the Render API (cloud Postgres + Storage/R2 URLs).
# Production (Vercel):
# NEXT_PUBLIC_API_BASE_URL=https://<your-render-api-host>
# Static hall home for Curator Desk Back (local default: http://127.0.0.1:8765/).
# NEXT_PUBLIC_STATIC_HOME_URL=http://127.0.0.1:8765/
# Production static host (same-origin `/` is fine when curator is bridged from static):
# NEXT_PUBLIC_STATIC_HOME_URL=https://your-static-host/
NEXT_PUBLIC_RECOGNITION_MODE=local
# Optional: Storage origin for next/image. Never put the service role key here.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Optional: public GLB host that is not Supabase Storage (avoids Cached Egress).
# NEXT_PUBLIC_GLB_BASE_URL=https://your-models-host.example

