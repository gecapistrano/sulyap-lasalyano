# Copy to .env.local (never commit secrets).
NEXT_PUBLIC_APP_NAME=Sulyap Lasalyano
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Production (Vercel):
# NEXT_PUBLIC_API_BASE_URL=https://<your-render-api-host>
# Static sulyap-lasalyano home for Curator Desk Back (local default: http://127.0.0.1:8765/).
# NEXT_PUBLIC_STATIC_HOME_URL=http://127.0.0.1:8765/
# Production static host (same-origin `/` is fine when curator is bridged from static):
# NEXT_PUBLIC_STATIC_HOME_URL=https://your-static-host/
NEXT_PUBLIC_RECOGNITION_MODE=local

