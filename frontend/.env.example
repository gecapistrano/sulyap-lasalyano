# Copy to `frontend/.env` or `frontend/.env.local` (never commit those files).

VITE_APP_NAME=Sulyap Lasalyano

# Where the FastAPI API runs (browser calls this URL).
# Local dev (typical):
VITE_API_BASE_URL=http://localhost:8000
# Production (Vercel → Project → Settings → Environment Variables):
#   VITE_API_BASE_URL=https://<your-render-or-api-host>
# Must be https in production. Rebuild/redeploy after changing it.
#
# On-device Live Scan (YOLO ONNX from /models — best Vercel performance):
VITE_RECOGNITION_MODE=local
