# Copy to `frontend/.env` or `frontend/.env.local` (never commit those files).

VITE_APP_NAME=Sulyap Lasalyano

# Where the FastAPI API runs (browser calls this URL).
# Local dev (typical):
VITE_API_BASE_URL=http://127.0.0.1:8000
# When frontend is on Vercel, set VITE_API_BASE_URL in Vercel → Project → Settings → Environment Variables
# to your public API origin, e.g. https://api.yourdomain.com  (must be https in production)
